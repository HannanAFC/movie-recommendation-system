	},
	"scripts": {
		"dev": "vite",
		"build": "vite build",
		"lint": "eslint .",
		"preview": "vite preview",
		"api": "python api/movie-recommendation-system.py",
		"db": "cd api && flask db upgrade",
		"clean": "rm -r api/app/datasets && rm -r api/models && rm -r api/app.db",
		"tailwind": "npx @tailwindcss/cli -i ./app/static/css/input.css -o ./app/static/css/output.css --watch",
		"prettier": "npx prettier --write **/*.html"
	},
	"homepage": "https://github.com/HannanAFC/movie-recommendation-system",
	"dependencies": {
		"@tailwindcss/vite": "^4.2.1",
		"axios": "^1.13.6",
